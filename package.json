{
  "name": "secure-eval-worker",
  "version": "0.2.0",
  "description": "Least-privilege worker-thread execution for untrusted JavaScript",
  "type": "module",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "require": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "files": [
    "docs",
    "src"
  ],
  "engines": {
    "node": ">=26.5.1 <27"
  },
  "scripts": {
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "test:node-capabilities": "node --no-warnings scripts/check-node-capabilities.js",
    "generate:node-capability-candidate": "node --no-warnings scripts/generate-node-capability-candidate.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:types": "node scripts/check-package-types.js",
    "test:package": "node scripts/check-package-contents.js",
    "measure:workers": "node --expose-gc scripts/measure-worker-overhead.js"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/platformatic/secure-eval-worker.git"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "eslint": "9.39.5",
    "neostandard": "0.13.0",
    "typescript": "7.0.2"
  }
}
